# ============================================
# AI Trading Platform — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ----- Application -----
APP_ENV=development
APP_NAME="AI Trading Platform"
APP_VERSION=1.0.0

# ----- Backend -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# ----- Database (PostgreSQL) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://trading_user:your_secure_password_here@localhost:5432/trading_platform

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ----- JWT Authentication -----
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Market Data APIs -----
# Yahoo Finance (free, no key needed)
YFINANCE_ENABLED=true

# Alpha Vantage (free tier: 25 requests/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# Polygon.io
POLYGON_API_KEY=your_polygon_key_here
POLYGON_BASE_URL=https://api.polygon.io

# Finnhub
FINNHUB_API_KEY=your_finnhub_key_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# NSE India (no key needed)
NSE_BASE_URL=https://www.nseindia.com/api

# ----- ML Service -----
ML_SERVICE_HOST=localhost
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001

# Model training
MODEL_SAVE_DIR=ml/saved_models
TRAINING_LOOKBACK_DAYS=365
LSTM_SEQUENCE_LENGTH=60
RETRAIN_INTERVAL_HOURS=168  # Weekly

# ----- Sentiment Analysis -----
FINBERT_MODEL=ProsusAI/finbert
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# ----- Alerts -----
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@aistockplatform.com

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME="AI Trading Platform"

# ----- CORS -----
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- Rate Limiting -----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json
