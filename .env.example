# ============================================
# AI Trading Platform — Environment Variables
# ============================================
# Copy to .env and fill in. Unknown keys are ignored by the backend.

# ----- Application -----
# production enforces a strong JWT secret
APP_ENV=development
LOG_LEVEL=INFO

# ----- Database -----
# Local dev default (no Postgres needed): sqlite+aiosqlite:///./trading.db
# Docker Compose builds the Postgres URL from the POSTGRES_* values below.
DATABASE_URL=sqlite+aiosqlite:///./trading.db
POSTGRES_DB=trading_platform
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# ----- Redis (optional; in-process cache is used when empty) -----
REDIS_URL=

# ----- JWT Authentication -----
# Generate with: openssl rand -hex 32   (required outside development)
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Market data -----
# optional, improves symbol search
FINNHUB_API_KEY=
# optional, more headlines for sentiment
NEWS_API_KEY=

# ----- ML service -----
ML_SERVICE_URL=http://localhost:8001
# required to call POST /train on the ML service
ML_SERVICE_API_KEY=
MODEL_SAVE_DIR=ml/saved_models

# ----- Trading bot -----
# paper         built-in simulator (default, no real money)
# alpaca_paper  Alpaca paper-trading account
# alpaca_live   REAL MONEY — also requires ALLOW_LIVE_TRADING=true
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
ALPACA_API_KEY=
ALPACA_API_SECRET=
BOT_UNIVERSE=AAPL,MSFT,GOOGL,AMZN,NVDA,META,JPM,V,WMT,JNJ
BOT_INITIAL_CAPITAL=100000
BOT_CYCLE_MINUTES=15

# ----- Optional Claude risk reviewer -----
# Claude can only approve, shrink or veto trades the risk manager already approved.
LLM_REVIEW_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# veto (safe) or approve when the API is unavailable
LLM_REVIEW_FAIL_MODE=veto

# ----- Equity research -----
# Claude-written analyst reports (admins trigger new ones; uses ANTHROPIC_API_KEY).
# Without it, research reports come from the free rules-based quant model.
RESEARCH_LLM_ENABLED=false
# Let the analyst use Anthropic's server-side web search for current news.
RESEARCH_WEB_SEARCH=false
RESEARCH_REPORT_MAX_AGE_HOURS=24
# Bot: no new entries this many days before a scheduled earnings report.
EARNINGS_BLACKOUT_DAYS=3

# ----- Bot safety -----
# Set to receive alerts (Slack/Discord/Teams-compatible JSON webhook).
ALERT_WEBHOOK_URL=
# Manage holdings the bot did not open (use a dedicated account instead).
BOT_ADOPT_EXTERNAL_POSITIONS=false
# Real-broker entries require a stored walk-forward calibration with positive OOS expectancy.
BOT_REQUIRE_CALIBRATION_FOR_BROKER=true

# ----- Accounts -----
# This email becomes administrator on registration; then set REGISTRATION_OPEN=false.
BOOTSTRAP_ADMIN_EMAIL=
REGISTRATION_OPEN=true

# ----- CORS / rate limiting -----
CORS_ORIGINS=http://localhost:3000,http://localhost
RATE_LIMIT_DEFAULT=120/minute

# ----- Frontend (build time) -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
